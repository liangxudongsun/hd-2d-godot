  "normal_recipe_sha256": "79ce7f41cf3ff9c8920724767ac6871d77c76ffad12f374fe599d461bd4c3399",
  "normal_method": "r2 manual re-annotation of the retained autumn sprite silhouettes: small visible leaf-spray ellipsoids, actual bark forks and stems, separate conifer hanging branch fans, flower disks and lily pads. Analytic vectors, normalized before 8-bit encoding. No diffuse-brightness height conversion. Each lobe uses a smoothstep outer feather to avoid geometric circular lighting seams; colors and alpha are untouched.",
  "normal_basis": "OpenGL tangent X right, Y up, Z towards camera",
  "normal_workflow": "Hand-annotated r2 canopy boughs, fronds and flower heads; analytic surface vectors independent of diffuse luminance",
  "normal_convention": "OpenGL tangent +X right, +Y up, +Z outward",
  "normal_generation": "Independently authored geometric relief; linear vector PNGs are paired with native AW color output",
